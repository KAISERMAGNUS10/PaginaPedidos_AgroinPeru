PORT=3000

# Supabase → botón "Connect" → "Transaction pooler" (puerto 6543).
# Reemplaza [YOUR-PASSWORD] por la contraseña de la base de datos de tu proyecto.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres

JWT_SECRET=CAMBIAR_POR_UNA_CLAVE_SEGURA
JWT_EXPIRES_IN=2h

# URL(s) del frontend que pueden llamar a la API, separadas por coma.
FRONTEND_URL=http://localhost:4200
