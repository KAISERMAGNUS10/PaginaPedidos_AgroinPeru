# Referencia de las variables que se configuran en Vercel → Settings → Environment Variables.
# (No se usa ningún archivo .env: la API corre solo en Vercel.)

# Supabase → Connect → Transaction pooler (puerto 6543), con la contraseña de la base de datos.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

JWT_SECRET=CAMBIAR_POR_UNA_CLAVE_SEGURA
JWT_EXPIRES_IN=8h
